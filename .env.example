# ============ CORE ============
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me
ADMIN_EMAILS=you@example.com
CORS_ORIGINS=http://localhost:5173

# ============ SUPABASE / DATABASE ============
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_MIGRATION_URL=

# ============ SEARCH ============
SEARCH_PROVIDER=serper
SERPER_API_KEY=
SERPAPI_KEY=
BRAVE_SEARCH_API_KEY=
SEARCH_CACHE_TTL_HOURS=168
SEARCH_MAX_RESULTS=20

# ============ LLM ============
AI_PROVIDER=groq
AI_FALLBACK_PROVIDERS=gemini,openai
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
AI_TIMEOUT=60
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ============ CRAWLER ============
CRAWLER_USER_AGENT=IntentBot/1.0 (+https://example.com/bot)
CRAWL_CONCURRENCY=5
CRAWL_DELAY_SECONDS=2.0
CRAWL_TIMEOUT_SECONDS=20
CRAWL_MAX_RETRIES=3
CRAWL_MAX_PAGES_PER_COMPANY=12
RESPECT_ROBOTS_TXT=true
PLAYWRIGHT_ENABLED=false

# ============ SIGNAL SOURCES (optional) ============
COMPANIES_HOUSE_API_KEY=
SEC_EDGAR_USER_AGENT=YourName your@email.com

# ============ INFRA ============
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=

# ============ SCORING ============
SCORE_WEIGHT_DETERMINISTIC=0.5
SCORE_WEIGHT_AI=0.3
SCORE_WEIGHT_EVIDENCE=0.2
DECISION_MAKER_THRESHOLD=80
AI_ANALYSIS_MIN_RAW_SCORE=25

# ============ COST GUARDS ============
MAX_COMPANIES_PER_DISCOVERY_RUN=200
MAX_AI_CALLS_PER_RUN=100
